{
  "name": "waw-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start:web": "node dist/server/web/main.js",
    "start:bot": "node dist/server/bot/main.js",
    "test": "node --test \"src/**/*.test.ts\" \"web/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.1.1",
    "@types/pg": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.2",
    "discord.js": "14.27.0",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.2.0"
  }
}
