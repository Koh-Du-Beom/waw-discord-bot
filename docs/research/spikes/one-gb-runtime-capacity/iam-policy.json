{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSpikeInventoryInSeoul",
      "Effect": "Allow",
      "Action": [
        "lightsail:GetActiveNames",
        "lightsail:GetAlarms",
        "lightsail:GetBlueprints",
        "lightsail:GetBundles",
        "lightsail:GetCertificates",
        "lightsail:GetDisks",
        "lightsail:GetInstance",
        "lightsail:GetInstanceAccessDetails",
        "lightsail:GetInstancePortStates",
        "lightsail:GetInstanceState",
        "lightsail:GetInstances",
        "lightsail:GetInstanceSnapshots",
        "lightsail:GetKeyPairs",
        "lightsail:GetLoadBalancers",
        "lightsail:GetOperation",
        "lightsail:GetOperations",
        "lightsail:GetRegions",
        "lightsail:GetStaticIps"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Sid": "ReadGlobalLightsailConsoleInventory",
      "Effect": "Allow",
      "Action": [
        "lightsail:GetDistributions",
        "lightsail:GetDomains"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateTaggedSpikeInstanceInSeoul",
      "Effect": "Allow",
      "Action": [
        "lightsail:CreateInstances",
        "lightsail:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:RequestTag/purpose": "waw-capacity-spike"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "purpose",
            "expires"
          ]
        }
      }
    },
    {
      "Sid": "OperateOnlyTaggedSpikeInstanceInSeoul",
      "Effect": "Allow",
      "Action": [
        "lightsail:CloseInstancePublicPorts",
        "lightsail:DeleteInstance",
        "lightsail:OpenInstancePublicPorts"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:ResourceTag/purpose": "waw-capacity-spike"
        }
      }
    },
    {
      "Sid": "ManageOneOffSpikeKeyPairInSeoul",
      "Effect": "Allow",
      "Action": [
        "lightsail:DeleteKeyPair",
        "lightsail:ImportKeyPair"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    }
  ]
}
