[Unit]
Description=WAW dashboard web application integration fixture
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30s
StartLimitBurst=4

[Service]
Type=simple
User=waw-web
Group=waw-web
LoadCredential=database-url:/etc/waw-credentials/web-database-url
LoadCredential=oauth-client-secret:/etc/waw-credentials/web-oauth-client-secret
Environment=WAW_WEB_HOST=127.0.0.1
Environment=WAW_WEB_PORT=18080
ExecStart=/usr/local/bin/node /opt/waw/current/dist/server/integration/web-fixture.js
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s
MemoryHigh=192M
MemoryMax=256M
TasksMax=96
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/waw/current
ReadWritePaths=/var/lib/waw-web
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=waw-web
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
