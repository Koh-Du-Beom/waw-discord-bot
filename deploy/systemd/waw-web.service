[Unit]
Description=WAW dashboard web application
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30s
StartLimitBurst=4

[Service]
Type=simple
User=waw-web
Group=waw-web
LoadCredential=database-url:/etc/waw-credentials/web-database-url
LoadCredential=oauth-client-secret:/etc/waw-credentials/web-oauth-client-secret
LoadCredential=csrf-key:/etc/waw-credentials/web-csrf-key
EnvironmentFile=-/etc/waw/web.env
Environment=WAW_WEB_HOST=127.0.0.1
Environment=WAW_WEB_PORT=18080
Environment=WAW_MEMBER_ROLE_SOCKET=/run/waw-member-role/member-role.sock
Environment=WAW_BOT_HEALTH_PATH=/run/waw-member-role/health.json
Environment=WAW_BACKUP_MARKER_PATH=/var/lib/waw-backup/last-published.json
Environment=WAW_ADMIN_COMMAND_IPC_ENABLED=0
Environment=WAW_DASHBOARD_QUOTA_ENABLED=0
Environment=WAW_ADMIN_COMMAND_SOCKET=/run/waw-admin-command/admin-command.sock
ExecStart=/usr/local/bin/node /opt/waw/current/dist/server/web/main.js
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s
MemoryHigh=192M
MemoryMax=256M
TasksMax=96
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/waw/current
ReadWritePaths=/var/lib/waw-web
SupplementaryGroups=waw-member-role waw-admin-command
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=waw-web
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
