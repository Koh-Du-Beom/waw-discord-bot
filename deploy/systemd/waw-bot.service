[Unit]
Description=WAW Discord Gateway bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30s
StartLimitBurst=4

[Service]
Type=simple
User=waw-bot
Group=waw-member-role
LoadCredential=discord-bot-token:/etc/waw-credentials/bot-discord-token
EnvironmentFile=-/etc/waw/bot.env
Environment=WAW_MEMBER_ROLE_SOCKET=/run/waw-member-role/member-role.sock
Environment=WAW_BOT_HEALTH_PATH=/run/waw-member-role/health.json
ExecStart=/usr/local/bin/node /opt/waw/current/dist/server/bot/main.js
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s
MemoryHigh=192M
MemoryMax=256M
TasksMax=96
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/waw/current
ReadWritePaths=/var/lib/waw-bot /run/waw-bot /run/waw-member-role
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RuntimeDirectory=waw-bot waw-member-role
RuntimeDirectoryMode=0750
StateDirectory=waw-bot
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
