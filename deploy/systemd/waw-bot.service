[Unit]
Description=WAW Discord Gateway bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30s
StartLimitBurst=4

[Service]
Type=simple
User=waw-bot
Group=waw-member-role
SupplementaryGroups=waw-admin-command
LoadCredential=discord-bot-token:/etc/waw-credentials/bot-discord-token
LoadCredential=database-url:/etc/waw-credentials/bot-database-url
LoadCredential=riot-api-key:/etc/waw-credentials/bot-riot-api-key
EnvironmentFile=-/etc/waw/bot.env
Environment=WAW_MEMBER_ROLE_SOCKET=/run/waw-member-role/member-role.sock
Environment=WAW_BOT_HEALTH_PATH=/run/waw-member-role/health.json
Environment=WAW_GAME_OBSERVATION_ENABLED=0
Environment=WAW_DISCORD_VOICE_RECONCILIATION_INTERVAL_MS=120000
Environment=WAW_DISCORD_VOICE_FRESHNESS_MS=180000
Environment=WAW_ADMIN_COMMAND_IPC_ENABLED=0
Environment=WAW_SUMMARY_QUOTA_ENABLED=0
Environment=WAW_SUMMARY_PROVIDER_ENABLED=0
Environment=WAW_KBO_BETTING_ENABLED=0
Environment=WAW_KBO_RANKINGS_ENABLED=0
Environment=WAW_KBO_DATA_RIGHTS_AUTHORIZED=0
Environment=WAW_ADMIN_COMMAND_SOCKET=/run/waw-admin-command/admin-command.sock
ExecStartPre=+/usr/bin/install -d -o waw-bot -g waw-admin-command -m 0750 /run/waw-admin-command
ExecStart=/usr/local/bin/node /opt/waw/current/dist/server/bot/main.js
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s
MemoryHigh=192M
MemoryMax=256M
TasksMax=96
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/waw/current
ReadWritePaths=/var/lib/waw-bot /run/waw-bot /run/waw-member-role -/run/waw-admin-command
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RuntimeDirectory=waw-bot waw-member-role
RuntimeDirectoryMode=0750
StateDirectory=waw-bot
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
